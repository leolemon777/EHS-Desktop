      "value": "#f5f4fb",
      "role": "Main page background"
    },
    {
      "name": "Surface",
      "value": "#ffffff",
      "role": "Card and panel surface"
    },
    {
      "name": "Ink",
      "value": "#161a20",
      "role": "Primary text and dark contrast tile"
    },
    {
      "name": "Iris",
      "value": "#934cff",
      "role": "Primary accent and gradient anchor"
    },
    {
      "name": "Azure",
      "value": "#2f7cf8",
      "role": "Secondary gradient stop and focus ring"
    },
    {
      "name": "Sky Mist",
      "value": "#78aafa",
      "role": "Lift highlight in gradient and chip fills"
    },
    {
      "name": "Hairline",
      "value": "#e6e4f0",
      "role": "Borders, dividers, input frames"
    },
    {
      "name": "Muted",
      "value": "#6b6f7b",
      "role": "Secondary text and helper labels"
    }
  ],
